# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.eggs/

# uv and venvs
.venv/
.uv-cache/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Editors and OS
.DS_Store
.vscode/
.idea/
.claude/
*.swp
*.swo

# Notebooks
.ipynb_checkpoints/

# ML artifacts
*.pt
*.bin
*.safetensors
*.so
wandb/

# Generated artifacts. Keep the directory README and manifest YAMLs
# tracked so the directory stays meaningful in a fresh clone.
runs/*
!runs/README.md

checkpoints/*
!checkpoints/README.md

data/*
!data/README.md
!data/literature/
!data/**/*.yaml
!data/**/manifest.yaml

# Reports and figures generated at runtime
docs/figures/*.png
docs/figures/*.jpg
docs/figures/*.pdf
!docs/figures/.gitkeep
